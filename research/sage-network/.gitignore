# Source snapshots are large, and redistributable only under Sefaria's terms.
data/raw/

# Derived outputs, until a complete run produces them. Committing a partial
# manifest or a half-corpus count would put numbers in the repository that
# nobody can reproduce.
data/*.json

# Fetched sources for the passage pilot and the follow-up research, for the same
# reason: some are licensed only for display, and manuscript photographs carry
# their library's terms. They are kept in the private sage_network lake, and each
# reading records every source's address and SHA256.
pilot/inputs/
pilot/attempts/
followup-v1/cases/*/sources/
followup-v1/cases/*/work/
followup-v1/cases/*/review-sources/
heldout-v2/inputs/
